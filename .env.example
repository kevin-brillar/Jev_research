# Jev: use "mock" for an offline demo or "live" for the TypeSafe API.
JEV_MODE=mock
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest

# Writer model used by the ADK chat agent.
ATENXION_WRITER_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Select which runtime the built-in ADK UI loads: adk1 or adk2.
ADK_RUNTIME=adk1

